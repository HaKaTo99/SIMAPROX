# Core Server
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database (required)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simapro_enterprise
DB_USER=postgres
DB_PASSWORD=changeme

# JWT (use JWT_SECRETS for rotation; first secret signs new tokens)
# Either provide JWT_SECRETS (comma or JSON array) OR fallback JWT_SECRET
JWT_SECRETS=["devSecretLongEnough_ChangeMe","previousSecretBackup"]
# JWT_SECRET=legacySingleSecret_OnlyIfNotUsingArray
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
REFRESH_TOKEN_ROTATE=true
REFRESH_CLEAN_INTERVAL_MS=900000
REFRESH_REVOKED_GRACE_HOURS=12

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Readiness / Health
READINESS_RSS_WARN_MB=600

# Admin Seeding
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_COMPANY_CODE=MAIN
FORCE_ADMIN_PASSWORD=0
ALLOW_FORCE_ADMIN_PROD=0

# Security / Flags (placeholders for future use)
# FEATURE_FLAG_CACHE_TTL=60000

# Logging / Metrics
# LOG_LEVEL=info
# PROMETHEUS_METRICS_ENABLED=1

# Optional: Force password reset script behavior
# ALLOW_IN_PRODUCTION=0
# RANDOM_PASSWORDS=0
# PASSWORD_LENGTH=16

# Frontend (CRA / Vite style example if needed)
# VITE_API_URL=http://localhost:5000/api
