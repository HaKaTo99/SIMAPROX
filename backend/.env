# Backend Environment Example
# Copy this file to .env and adjust values for your environment.
# NEVER commit your real .env file with production secrets.

# =========================
# Server Configuration
# =========================
NODE_ENV=development
PORT=5000
APP_NAME=simapro-enterprise
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# =========================
# Database Configuration
# =========================
DB_HOST=localhost
DB_PORT=5432
# Match the database name actually used in development; adjust if different
DB_NAME=simaproxen
DB_USER=postgres
# Password harus cocok dengan instance Postgres lokal atau docker-compose (lihat docker-compose.yml -> POSTGRES_PASSWORD: password)
# Password diperbarui sesuai kredensial yang diberikan
DB_PASSWORD=D0d0lg4rut!
DB_SSL=false

# Alias untuk pool yang pakai PG* (sinkron dengan nilai DB_*)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=D0d0lg4rut!
PGDATABASE=simaproxen

# =========================
# JWT / Auth Configuration
# =========================
# Generate a strong secret for production, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_jwt_secret_in_production
# ACCESS_TOKEN_EXPIRES format: 15m atau 900s
ACCESS_TOKEN_EXPIRES=1440m
REFRESH_TOKEN_EXPIRES_DAYS=7
REFRESH_TOKEN_ROTATE=true

# =========================
# Rate Limiting
# =========================
RATE_GLOBAL_WINDOW_MS=900000
RATE_GLOBAL_MAX=1000
RATE_LOGIN_WINDOW_MS=300000
RATE_LOGIN_MAX=20
RATE_TOKEN_WINDOW_MS=300000
RATE_TOKEN_MAX=60

# =========================
# Content Security Policy (optional extras)
# =========================
# Append additional allowed hosts (comma separated). Leave blank if not needed.
CSP_SCRIPT_EXTRA=
CSP_STYLE_EXTRA=
CSP_FRAME_EXTRA=

# =========================
# File Upload Configuration
# =========================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# =========================
# Metrics / Observability
# =========================
# Metrics toggle (true/false)
ENABLE_METRICS=true

# =========================
# Email (Optional)
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SEED_ADMIN_EMAIL=admin@example.com

# =========================
# AI/ML (Optional)
# =========================
# (Optional future) AI microservice
# AI_SERVICE_URL=http://localhost:8000
# AI_SERVICE_TOKEN=your_ai_service_token

DELETE FROM users WHERE username <> 'admin';
